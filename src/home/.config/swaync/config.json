{
    "$schema": "/etc/xdg/swaync/configSchema.json",
    "ignore-gtk-theme": true,
    "positionX": "right",
    "positionY": "top",
    "control-center-margin-top": 8,
    "control-center-margin-bottom": 8,
    "control-center-margin-right": 8,
    "control-center-margin-left": 0,
    "notification-body-image-height": 200,
    "notification-body-image-width": 200,
    "timeout": 4,
    "timeout-low": 2,
    "timeout-critical": 0,
    "fit-to-screen": true,
    "control-center-width": 440,
    "notification-window-width": 440,
    "keyboard-shortcuts": true,
    "image-visibility": "when-available",
    "transition-time": 0,
    "text-empty": "NO NOTIFICATIONS",
    "hide-on-clear": false,
    "hide-on-action": true,
    "widgets": [
        "title",
        "dnd",
        "volume",
        "backlight",
        "mpris",
        "buttons-grid",
        "menubar",
        "notifications"
    ],
    "widget-config": {
        "title": {
            "text": "SYSTEM MONITOR",
            "clear-all-button": true,
            "button-text": "CLEAR ALL"
        },
        "dnd": {
            "text": "DO NOT DISTURB"
        },
        "mpris": {
            "autohide": true,
            "show-album-art": "when-available"
        },
        "volume": {
            "label": "VOL",
            "animation-type": "none",
            "animation-duration": 0
        },
        "backlight": {
            "label": "BRI"
        },
        "notifications": {
            "vexpand": true
        },
        "buttons-grid": {
            "buttons-per-row": 4,
            "actions": [
                {
                    "label": "󰖩",
                    "type": "toggle",
                    "active": true,
                    "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && nmcli radio wifi on || nmcli radio wifi off >/dev/null 2>&1'",
                    "update-command": "sh -c '[[ $(nmcli radio wifi) == \"enabled\" ]] && echo true || echo false'"
                },
                {
                    "label": "󰂯",
                    "type": "toggle",
                    "active": true,
                    "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && bluetoothctl power on || bluetoothctl power off >/dev/null 2>&1'",
                    "update-command": "bluetoothctl show | grep -q 'Powered: yes' && echo true || echo false"
                },
                {
                    "label": "󰖔",
                    "type": "toggle",
                    "active": true,
                    "command": "$HOME/.local/bin/nightlight_toggle.sh >/dev/null 2>&1",
                    "update-command": "$HOME/.local/bin/nightlight_toggle.sh --check >/dev/null 2>&1 && echo true || echo false"
                },
                {
                    "label": "󰝟",
                    "type": "toggle",
                    "active": true,
                    "command": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle >/dev/null 2>&1",
                    "update-command": "wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q 'MUTED' && echo true || echo false"
                },
                {
                    "label": "󰒳",
                    "type": "toggle",
                    "active": true,
                    "command": "$HOME/.local/bin/idle_inhibit.sh --toggle >/dev/null 2>&1",
                    "update-command": "$HOME/.local/bin/idle_inhibit.sh --check >/dev/null 2>&1 && echo true || echo false"
                },
                {
                    "label": "󰝚",
                    "type": "toggle",
                    "active": true,
                    "command": "$HOME/.local/bin/cava_manager.sh >/dev/null 2>&1",
                    "update-command": "[ -s /tmp/cava-layer.pid ] && echo true || echo false"
                },
                {
                    "label": " ",
                    "type": "toggle",
                    "active": true,
                    "command": "$HOME/.local/bin/random_wallpaper.sh >/dev/null 2>&1",
                    "update-command": "grep -q '1' /tmp/random_wallpaper_status 2>/dev/null && echo true || echo false"
                },
                {
                    "label": "󰒃",
                    "type": "toggle",
                    "active": true,
                    "command": "$HOME/.local/bin/warp_toggle.sh >/dev/null 2>&1",
                    "update-command": "warp-cli status 2>/dev/null | grep -q 'Connected' && echo true || echo false"
                }
            ]
        },
        "menubar": {
            "menu#power-buttons": {
                "label": "󰤆  POWER",
                "position": "left",
                "animation-type": "slide_down",
                "animation-duration": 0,
                "actions": [
                    {
                        "label": "󰑓   REBOOT",
                        "command": "systemctl reboot"
                    },
                    {
                        "label": "   LOCK",
                        "command": "$HOME/.local/bin/lock.sh"
                    },
                    {
                        "label": "   EXIT",
                        "command": "$HOME/.local/bin/exit.sh"
                    },
                    {
                        "label": "󰤆   SHUT DOWN",
                        "command": "systemctl poweroff"
                    }
                ]
            },
            "menu#powermode-buttons": {
                "label": "󱓞  MODE",
                "position": "left",
                "animation-type": "slide_down",
                "animation-duration": 0,
                "actions": [
                    {
                        "label": "PERFORMANCE",
                        "command": "powerprofilesctl set performance"
                    },
                    {
                        "label": "BALANCED",
                        "command": "powerprofilesctl set balanced"
                    },
                    {
                        "label": "POWER-SAVER",
                        "command": "powerprofilesctl set power-saver"
                    }
                ]
            }
        }
    }
}
