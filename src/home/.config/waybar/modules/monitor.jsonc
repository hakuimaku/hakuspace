{
    "group/monitor": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 0,
            "transition-left-to-right": false,
            "click-to-reveal": true
        },
        "modules": [
            "custom/monitor",
            "cpu",
            "memory",
            "temperature"
        ]
    },
    "custom/monitor": {
        "format": "SYS",
        "tooltip": true,
        "tooltip-format": "Click to toggle CPU / Memory / Temp"
    },
    "cpu": {
        "interval": 2,
        "format": "CPU {usage}%"
    },
    "memory": {
        "interval": 2,
        "format": "MEM {used:0.1f}G"
    },
    "temperature": {
        "interval": 2,
        "format": "{temperatureC}°C"
    }
}
