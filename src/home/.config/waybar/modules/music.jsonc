{
    "group/music": {
        "orientation": "horizontal",
        "modules": [
            "mpris",
            "cava"
        ]
    },
    "mpris": {
        "format": "♪ {artist} — {title}",
        "format-paused": "❚❚ {title}",
        "format-stopped": "",
        "artist-len": 16,
        "title-len": 24,
        "ellipsis": "…"
    },
    "cava": {
        "cava_config": "$HOME/.config/cava/config_waybar",
        "input_delay": 0,
        "bar_delimiter": 0,
        "hide_on_silence": true,
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
    }
}
