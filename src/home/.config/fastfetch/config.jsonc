{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/hakufetch.txt",
        "type": "auto",
        "position": "top",
        "padding": { "left": 2 },
        "color": { "1": "white" }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "white", "output": "white", "title": "white" },
        "constants": ["\u001b[37m", "\u001b[37m"]
    },
    "modules": [
        {
            "type": "custom",
            "key": "  ╭─Haku-Space─╮"
        },
        {
            "type": "command",
            "key": "  │ {$2}{$1}  user    │",
            "text": "echo $USER"
        },
        {
            "type": "kernel",
            "key": "  │ {$2}{$1}  kernel  │"
        },
        {
            "type": "os",
            "key": "  │ {$2}{$1}  os      │"
        },
        {
            "type": "wm",
            "key": "  │ {$2}{$1}  wm      │"
        },
        {
            "type": "disk",
            "key": "  │ {$2}{$1}  disk    │",
            "folder": "/"
        },
        {
            "type": "memory",
            "key": "  │ {$2}{$1}  memory  │"
        },
        {
            "type": "packages",
            "key": "  │   pkgs    │"
        },
        {
            "type": "custom",
            "key": "  ╰────────────╯"
        },
        {
            "type": "colors",
            "key": "  ",
            "symbol": "circle"
        }
    ]
}