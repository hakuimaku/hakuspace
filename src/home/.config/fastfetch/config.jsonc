{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/hakufetch.txt",
        "type": "auto",
        "position": "top",
        "padding": { "left": 2 },
        "color": { "1": "default" }
    },
    "display": {
        "separator": " ",
        "color": { "keys": "default", "output": "default", "title": "default" }
    },
    "modules": [
        {
            "type": "custom",
            "format": "  {#90}╭────────────────────────────────────────╮{#}"
        },
        {
            "type": "title",
            "key": "  {#90}│\u001b[s\u001b[40C│\u001b[u{#}",
            "format": "{#1}  {user-name} @ {host-name}{#}"
        },
        {
            "type": "custom",
            "format": "  {#90}╰────────────────────────────────────────╯{#}"
        },
        {
            "type": "custom",
            "format": "  {#90}╭─ {#}{#1}System{#}"
        },
        {
            "type": "os",
            "key": "  {#90}│ ├{#}   os     "
        },
        {
            "type": "kernel",
            "key": "  {#90}│ ├{#}   kernel "
        },
        {
            "type": "wm",
            "key": "  {#90}│ ├{#}   wm     "
        },
        {
            "type": "packages",
            "key": "  {#90}│ └{#}   pkgs   "
        },
        {
            "type": "custom",
            "format": "  {#90}├─ {#}{#1}Hardware{#}"
        },
        {
            "type": "memory",
            "key": "  {#90}│ ├{#}   memory "
        },
        {
            "type": "disk",
            "key": "  {#90}│ └{#}   disk   ",
            "folders": "/"
        },
        {
            "type": "colors",
            "key": "  {#90}╰─{#}",
            "symbol": "circle"
        }
    ]
}
