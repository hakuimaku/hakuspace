//      /_.___/_/_/ /_/\__,_/____/ 
//                                                                                 

// DO NOT EDIT THIS FILE, EDIT ~/hakucfg/wm/niri-custom.kdl INSTEAD

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Main keybindings
    Mod+Q            hotkey-overlay-title="Open a Terminal: kitty" { spawn "kitty"; }
    Mod+C            repeat=false { close-window; }
    Mod+E            hotkey-overlay-title="Open File Manager" { spawn "sh" "-c" "xdg-open \"$HOME\""; }
    Mod+Space        hotkey-overlay-title="Run Application Menu" { spawn "sh" "-c" "$HOME/.local/bin/launcher.sh drun"; }
    Mod+B            hotkey-overlay-title="Open Browser" { spawn "sh" "-c" "$HOME/.local/bin/open_browser.sh"; }
    Mod+Slash        hotkey-overlay-title="Open Emoji Menu" { spawn "sh" "-c" "$HOME/.local/bin/launcher.sh emoji"; }
    Mod+R            repeat=false hotkey-overlay-title="Toggle Temp Note" { spawn "sh" "-c" "$HOME/.local/bin/temp_note.sh"; }
    Mod+I            hotkey-overlay-title="Settings" { spawn "sh" "-c" "$HOME/.local/bin/settings_manager.sh"; }
    Mod+N            hotkey-overlay-title="Open Notification Center" { spawn "sh" "-c" "$HOME/.local/bin/notif.sh toggle"; }
    Mod+Escape       hotkey-overlay-title="Emergency Classic Backend" { spawn "sh" "-c" "$HOME/.local/bin/haku_backend.sh set classic"; }

    Mod+V            hotkey-overlay-title="Clipboard Menu" { spawn "sh" "-c" "$HOME/.local/bin/clipboard_menu.sh"; }
    Mod+Shift+V      hotkey-overlay-title="Wipe Clipboard" { spawn "sh" "-c" "$HOME/.local/bin/clipboard_menu.sh --wipe"; }
    Mod+F11          hotkey-overlay-title="Record Screen" { spawn "sh" "-c" "$HOME/.local/bin/record.sh"; }
    Mod+Tab          hotkey-overlay-title="Haku Menu" { spawn "sh" "-c" "$HOME/.local/bin/hakumenu.sh"; }
    Mod+Grave        hotkey-overlay-title="Hikai Navigation" { spawn "sh" "-c" "$HOME/.local/bin/navigation.sh toggle"; }
    Mod+Y            hotkey-overlay-title="Wallpaper Select" { spawn "sh" "-c" "$HOME/.local/bin/wallpaper_select.sh"; }
    Mod+Shift+Y      hotkey-overlay-title="Change Theme" { spawn "sh" "-c" "$HOME/.local/bin/change_theme.sh"; }
    Mod+Shift+E      hotkey-overlay-title="Exit Session" { spawn "sh" "-c" "$HOME/.local/bin/exit.sh"; }
    Mod+Shift+Q      hotkey-overlay-title="Power Menu" { spawn "sh" "-c" "$HOME/.local/bin/shutdown.sh"; }

    Mod+T            hotkey-overlay-title="Cava Underbar" { spawn "sh" "-c" "$HOME/.local/bin/cava_manager.sh"; }
    Mod+Shift+T      hotkey-overlay-title="Toggle Cava Position" { spawn "sh" "-c" "$HOME/.local/bin/cava_manager.sh --position"; }
    Mod+P           { screenshot; }
    Mod+Shift+P     { screenshot-screen; }
    Mod+Alt+P       { screenshot-window; }

    Mod+Shift+Z      hotkey-overlay-title="Cycle Waybar Mode" { spawn "sh" "-c" "$HOME/.local/bin/waybar_manager.sh --cycle"; }
    Mod+Z            hotkey-overlay-title="Toggle Taskbar" { spawn "sh" "-c" "$HOME/.local/bin/taskbar_manager.sh --toggle"; }
    Mod+Ctrl+Z       hotkey-overlay-title="Toggle Waybar" { spawn "sh" "-c" "$HOME/.local/bin/waybar_manager.sh --toggle"; }

    // Window management keybindings
    Mod+W            { toggle-window-floating; }
    Mod+G            repeat=false { toggle-overview; }

    Mod+D            { set-column-width "+10%"; }
    Mod+Shift+D      { set-column-width "-10%"; }

    Mod+F            { maximize-column; }
    Mod+Shift+F      { fullscreen-window; }
    Mod+Alt+F        { maximize-window-to-edges; }
    Mod+M            { maximize-window-to-edges; }

    Mod+Left  { focus-column-left; }
    Mod+A     { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+S     { focus-column-right; }

    Mod+Shift+A     { move-column-left; }
    Mod+Shift+S     { move-column-right; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }

    // Mouse & Touchpad Wheels
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // Workspace Indices (1-9)
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // Audio - Media Controls
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "$HOME/.local/bin/level_control.sh volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "$HOME/.local/bin/level_control.sh volume-down"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "$HOME/.local/bin/level_control.sh volume-mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "$HOME/.local/bin/level_control.sh mic-mute"; }

    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPause       allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "$HOME/.local/bin/level_control.sh brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "$HOME/.local/bin/level_control.sh brightness-down"; }
}
