import QtQuick
import QtQuick.Window
import Quickshell
import Quickshell.Wayland
import "../services"
import "windownav"

PanelWindow {
    id: root
    // Release only after the surface has finished its visual close.
    readonly property bool releaseReady: !ownsSession && reveal === 0 && !WindowNavigator.pendingAddress
    required property var modelData
    // One logical session owns one visible surface and one keyboard grab.
    readonly property bool ownsSession: WindowNavigator.active && WindowNavigator.screenName === modelData.name
    property string visualMode: "switcher"
    property real reveal: 0
    // Ignore hover generated by moving cards until the pointer itself moves.
    property bool pointerNavigation: false
    property point lastPointer: Qt.point(-1, -1)
    screen: modelData
    anchors { top: true; bottom: true; left: true; right: true }
    exclusiveZone: 0
    exclusionMode: ExclusionMode.Ignore
    color: "transparent"
    WlrLayershell.namespace: "hakuspace-window-navigator"
    WlrLayershell.layer: ShellTransitionState.chromeOverlayLayer
    WlrLayershell.keyboardFocus: ownsSession ? WlrKeyboardFocus.Exclusive : WlrKeyboardFocus.None
    visible: ownsSession || reveal > 0
    mask: Region { item: root.ownsSession ? inputSurface : null }

    // Reverse the fade continuously when reopening during dismissal.
    onOwnsSessionChanged: {
        if (ownsSession) {
            pointerNavigation = false
            lastPointer = Qt.point(-1, -1)
            visualMode = WindowNavigator.mode
            reveal = 1
            inputSurface.forceActiveFocus()
        } else reveal = 0
    }
    onRevealChanged: {
        if (reveal === 0 && !ownsSession) WindowNavigator.finishClose(modelData.name)
    }
    // A keyboard-leave acknowledgement completes activation without an arbitrary delay.
    Connections {
        target: root.contentItem.Window.window
        function onActiveChanged() {
            if (!root.ownsSession && !root.contentItem.Window.window.active)
                WindowNavigator.activatePending()
        }
    }
    onVisibleChanged: if (!visible) Qt.callLater(function() {
        if (!root) return
        if (root.visible) return
        WindowNavigator.activatePending()
        WindowNavigator.finishClose(root.modelData.name)
    })
    Behavior on reveal {
        enabled: WindowNavigator.available
        NumberAnimation { duration: HAnimation.normal; easing.type: Easing.BezierSpline; easing.bezierCurve: HAnimation.moduleCurve }
    }
    Connections {
        target: WindowNavigator
        function onModeChanged() { if (root.ownsSession) root.visualMode = WindowNavigator.mode }
        function onAvailableChanged() { if (!WindowNavigator.available) root.reveal = 0 }
        function onSelectedIndexChanged() { root.pointerNavigation = false }
    }

    Item {
        id: inputSurface
        anchors.fill: parent
        enabled: root.ownsSession
        focus: root.ownsSession
        HoverHandler {
            onPointChanged: {
                if (root.lastPointer.x >= 0 && Math.hypot(point.position.x - root.lastPointer.x,
                    point.position.y - root.lastPointer.y) >= Interaction.pointerModeThreshold)
                    root.pointerNavigation = true
                root.lastPointer = point.position
            }
        }
        // Consume modal keyboard input before ordinary shell controls see it.
        Keys.onPressed: event => {
            root.pointerNavigation = false
            event.accepted = true
            if (event.key === Qt.Key_Escape) WindowNavigator.cancel()
            else if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter) WindowNavigator.commit()
            else if (event.key === Qt.Key_Tab || event.key === Qt.Key_Backtab)
                WindowNavigator.step(event.key === Qt.Key_Backtab || (event.modifiers & Qt.ShiftModifier) ? -1 : 1)
            else if (root.visualMode === "overview") {
                if (event.key === Qt.Key_Home) WindowNavigator.select(0)
                else if (event.key === Qt.Key_End) WindowNavigator.select(WindowNavigator.sessionWindows.length - 1)
                else if (atlas.item) atlas.item.navigate(event.key)
            }
        }
        Keys.onReleased: event => {
            event.accepted = true
            if (!event.isAutoRepeat && event.key === Qt.Key_Alt) WindowNavigator.commitSwitcher()
        }
        // The full-output backdrop dismisses without leaking clicks or wheel events.
        MouseArea {
            anchors.fill: parent
            acceptedButtons: Qt.AllButtons
            onClicked: WindowNavigator.cancel()
            onWheel: wheel => wheel.accepted = true
        }
        Loader {
            anchors.fill: parent
            active: root.visible && root.visualMode === "switcher"
            sourceComponent: QuickSwitcher { reveal: root.reveal; pointerNavigation: root.pointerNavigation }
        }
        Loader {
            id: atlas
            anchors.fill: parent
            active: root.visible && root.visualMode === "overview"
            sourceComponent: WindowOverview { reveal: root.reveal; pointerNavigation: root.pointerNavigation }
        }
    }
}
