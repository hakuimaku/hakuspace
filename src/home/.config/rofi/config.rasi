configuration {
    modes: "drun,run,window";
    show-icons: true;
    terminal: "kitty";
    drun-display-format: "{icon} {name}";
    disable-history: false;
    display-drun: "  Apps ";
    display-run: "  Run ";
    display-window: " 󰙀 Window ";
    sidebar-mode: true;
    window-format: "{w} | {c} | {t}";
    hover-select: true;
    kb-cancel: "Escape,MousePrimary";
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

@import "~/.local/state/hakuspace/rofi-theme.rasi"