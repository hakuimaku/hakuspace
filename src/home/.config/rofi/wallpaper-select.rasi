// HakuSpace Rofi Theme
// Theme: wallpaper-select.rasi, use for wallpaper selection

@import "config.rasi"

window {
    width: 90%;
    height: 400px;
    padding: 20px;
}

mainbox {
    children: [ inputbar, content-area ];
}

content-area {
    children: [ listview ];
}

listview {
    columns: 6;
    lines: 1;
    spacing: 5px;
    padding: 5px;
    layout: vertical;
}

element {
    orientation: vertical;
    padding: 5px;
}

element-text {
    horizontal-align: 0.5;
}

element-icon {
    size: 230px;
    vertical-align: 0.5;
    horizontal-align: 0.7;
}

element selected {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 10px;
}

element-text selected {
    text-color: @accent;
}