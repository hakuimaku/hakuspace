// HakuSpace Rofi Theme
// Theme: wallpaper-select.rasi, use for wallpaper selection

@import "../../.local/state/hakuspace/theme/rofi-style.rasi"


/* ===== GLOBAL VARIABLES ===== */
* {
    font:                "JetBrainsMono Nerd Font 11";
    background:          rgba(0, 0, 0, 0.7);
    foreground:          #dfdfdf;
    background-color:    transparent;
    text-color:          @foreground;

    border-radius:       0;
    margin:              0;
    padding:             0;
    spacing:             0;
}

/* ===== MAIN WINDOW ===== */
window {
    width: 90%;
    height: 380px;
    background-color: @background;
    padding: 20px;
    border-radius: 0;
}

mainbox {
    orientation: vertical;
    spacing: 20px;
    children: [ inputbar, content-area ];
}

/* ===== CONTENT AREA ===== */
content-area {
    orientation: horizontal;
    spacing: 0;
    children: [ listview ];
}

/* ===== INPUT BAR ===== */
inputbar {
    orientation: horizontal;
    children: [ prompt, entry ];
}

prompt {
    padding:             10px 15px;
    background-color:    @accent;
    text-color:          @background;
    border-radius:       12px 0 0 12px;
}

entry {
    padding:             10px;
    margin:              0 10px;
    text-color:          @accent;
    placeholder:         "Search...";
    placeholder-color:   rgba(223, 223, 223, 0.4);
    background-color:    rgba(255, 255, 255, 0.1);
    border-radius:       0 12px 12px 0;
}

/* ===== LISTVIEW ===== */
listview {
    columns: 6;
    lines: 1;
    spacing: 5px;
    padding: 5px;
    layout: vertical;
    scrollbar: true;
    cycle: true;
    dynamic: true;
}

/* ===== ELEMENTS ===== */
element {
    orientation: vertical;
    padding: 5px;
    vertical-align: 0.5;
}

element-icon {
    size: 230px;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}

element-text {
    text-color: @accent;
    horizontal-align: 0.5;
}

/* ===== ELEMENT STATES ===== */
element selected {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 10px;
}

element-text selected {
    text-color: @accent;
}

/* ===== SCROLLBAR ===== */
scrollbar {
    handle-width: 6px;
    handle-color: @accent;
    padding: 0px 0px 0px 20px;
}