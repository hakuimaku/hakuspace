// HakuSpace Rofi Theme
// Theme: line.rasi

@import "../../../.local/state/hakuspace/theme/rofi-style.rasi"

/* ===== GLOBAL VARIABLES ===== */
* {
    background:          rgba(0, 0, 0, 0.7);
    foreground:          #dfdfdf;
    background-color:    transparent;
    text-color:          @foreground;
    
    margin:              0;
    padding:             0;
    spacing:             0;
}

/* ===== MAIN WINDOW ===== */
window {
    width:               35%;
    height:              50%;
    background-color:    @background;
    padding:             20px;
    border-radius:       0;
}

mainbox {
    spacing:             12px;
    children:            [ inputbar, content-area ];
}

/* ===== CONTENT AREA ===== */
content-area {
    orientation:         vertical;
    spacing:             0;
    children:            [ mode-switcher, listview ];
}

/* ===== INPUT BAR ===== */
inputbar {
    margin:              0 6px;
    children:            [ prompt, entry ];
    border:              0 0 3px 0;
    border-color:        @accent;
    border-radius:       0;
}

prompt {
    padding:             6px 10px;
    background-color:    @accent;
    text-color:          @background;
    border-radius:       12px 12px 0 0;
}

entry {
    padding:             6px;
    margin:              0 10px;
    text-color:          @accent;
    placeholder:         "Search...";
    placeholder-color:   rgba(223, 223, 223, 0.3);
}

/* ===== MODE SWITCHER (Apps/Run/Window) ===== */
mode-switcher {
    margin:              0 6px 6px 6px;
    padding:             0;
    background-color:    transparent;
    spacing:             6px;
    border:              3px 0 0 0;
    border-color:        @accent;
    border-radius:       0;
}

button {
    padding:             8px 14px;
    background-color:    transparent;
    text-color:          @accent;
    border-radius:       0 0 12px 12px;
}

button selected {
    background-color:    @accent;
    text-color:          @background;
}

/* ===== LISTVIEW ===== */
listview {
    scrollbar:           true;
    cycle:               true;
    dynamic:             true;
    border-radius:       0;
}

/* ===== ELEMENTS ===== */
element {
    padding:             6px;
    margin:              6px;
    orientation:         horizontal;
    vertical-align:      0.5; 
    border-radius:       6px;
}

element-icon {
    size:                24px;
    margin:              0 10px 0 0;
    vertical-align:      0.5;
}

element-text {
    text-color:          @accent;
    vertical-align:      0.5;
}

/* ===== ELEMENT STATES ===== */
element selected {
    background-color:    @accent;
}

element-text selected {
    text-color:          @background;
}

/* ===== SCROLLBAR ===== */
scrollbar {
    handle-width:           6px;
    handle-color:           @accent;
    padding:                0px 0px 0px 6px;
}