// HakuSpace Rofi Theme
// Theme: tablet.rasi

@import "../../../.local/state/hakuspace/theme/rofi-style.rasi"

/* ===== GLOBAL VARIABLES ===== */
* {
    img:                 url("../../.cache/walpaper_box_gen.jpg", height);
    background:          rgba(0, 0, 0, 0.7);
    foreground:          #dfdfdf;
    background-color:    transparent;
    text-color:          @foreground;

    border-radius:       0;
    margin:              0;
    padding:             0;
    spacing:             0;
}

/* ===== MAIN WINDOW ===== */
window {
    width:               50%;
    height:              50%;
    background-color:    @background;
    padding:             24px;
    border-radius:       20px;
}

mainbox {
    orientation:         vertical;
    spacing:             20px;
    children:            [ inputbar, boxbar ];
}

/* ===== BOX BAR ===== */
boxbar {
    orientation:         horizontal;
    spacing:             20px;
    children:            [ imagebox, content-area ];
}

/* ===== CONTENT AREA ===== */
content-area {
    orientation:         horizontal;
    spacing:             0;
    children:            [ listview ];
}

/* ===== IMAGE BOX ===== */
imagebox {
    expand:                      false;
    width:                       20%;
    orientation:                 horizontal;
    border-radius:               20px;
    background-image:            @img;
    children:                    [ image-space, mode-switcher ];
}

image-space {
    expand:                      true;
}

/* ===== MODE SWITCHER ===== */
mode-switcher {
    expand:                      false;
    width:                       4.5%;
    orientation:                 vertical;
    spacing:                     0;
    background-color:            rgba(0, 0, 0, 0.7);
    border-radius:               0;
    margin:                      0;
    padding:                     8px 8px 8px 9px;
}

button {
    font:                        "JetBrainsMono Nerd Font 18";
    padding:                     8px 4px;
    horizontal-align:            0.36;
    text-color:                  @accent;
    border-radius:               0;
}

button selected {
    border-radius:               8px;
    background-color:            @accent-dim;
    text-color:                  @background;
}

/* ===== INPUT BAR ===== */
inputbar {
    orientation:         horizontal;
    children:            [ prompt, entry ];
}

prompt {
    padding:             10px 30px 10px 25px;
    background-color:    @accent;
    text-color:          @background;
    border-radius:       12px;
}

entry {
    padding:             10px;
    margin:              0 10px;
    text-color:          @accent;
    placeholder:         "Search...";
    placeholder-color:   rgba(223, 223, 223, 0.4);
    background-color:    rgba(255, 255, 255, 0.1);
    border-radius:       0 12px 12px 0;
}

/* ===== LISTVIEW ===== */
listview {
    scrollbar:           true;
    cycle:               true;
    dynamic:             true;
    layout:              vertical;
    margin:              0 0 0 10px;
}

/* ===== ELEMENTS ===== */
element {
    padding:             10px;
    orientation:         horizontal;
    vertical-align:      0.5; 
}

element-icon {
    size:                24px;
    margin:              0 10px 0 0;
    vertical-align:      0.5;
}

element-text {
    text-color:          @accent;
    vertical-align:      0.5;
}

/* ===== ELEMENT STATES ===== */
element selected {
    background-color:    @accent;
    border-radius:       12px;
}

element-text selected {
    text-color:          @background;
}

/* ===== SCROLLBAR ===== */
scrollbar {
    handle-width:           6px;
    handle-color:           @accent;
    padding:                0px 0px 0px 20px;
}