{
    "$schema": "/etc/xdg/swaync/configSchema.json",
    "positionX": "right",
    "positionY": "top",
    "control-center-margin-top": 20,
    "control-center-margin-bottom": 20,
    "control-center-margin-right": 20,
    "control-center-margin-left": 20,
    "notification-icon-size": 56,
    "notification-body-image-height": 200,
    "notification-body-image-width": 200,

    "timeout": 4,
    "timeout-low": 2,
    "timeout-critical": 0,

    "fit-to-screen": true,
    "control-center-width": 450,
    "notification-window-width": 600,
    "keyboard-shortcuts": true,
    "image-visibility": "when-available",
    "transition-time": 300,

    "hide-on-clear": false,
    "hide-on-action": true,
    
    "widgets": [
        "menubar",
        "buttons-grid",
        "volume",
        "backlight",
        "mpris",
        "title",
        "dnd",
        "notifications"
    ],
    "widget-config": {
        "title": {
            "text": "Notifications",
            "clear-all-button": true,
            "button-text": "Clear All"
        },
        "dnd": {
            "text": "Do Not Disturb"
        },
        "mpris": {
            "autohide": true
        },
        "volume": {
            "label": ""
        },
        "backlight": {
            "label": "󰖨"
        },
        "notifications": {
        },
        "buttons-grid": {
            "actions": [
                {
                    "label": "󰖩",
                    "type": "toggle",
                    "active": true,
                    "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && nmcli radio wifi on || nmcli radio wifi off >/dev/null 2>&1'",
                    "update-command": "sh -c '[[ $(nmcli radio wifi) == \"enabled\" ]] && echo true || echo false'"
                },
                {
                    "label": "󰂯",
                    "type": "toggle",
                    "active": true,
                    "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && bluetoothctl power on || bluetoothctl power off >/dev/null 2>&1'",
                    "update-command": "bluetoothctl show | grep -q 'Powered: yes' && echo true || echo false"
                },
                {
                    "label": "󰖔",
                    "type": "toggle",
                    "active": true,
                    "command": "$HOME/.local/bin/nightlight_toggle.sh >/dev/null 2>&1",
                    "update-command": "$HOME/.local/bin/nightlight_toggle.sh --check >/dev/null 2>&1 && echo true || echo false"
                },
                {
                    "label": "󰝟",
                    "type": "toggle",
                    "active": true,
                    "command": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle >/dev/null 2>&1",
                    "update-command": "wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q 'MUTED' && echo true || echo false"
                },
                {
                    "label": "󰒳",
                    "type": "toggle",
                    "active": true,
                    "command": "$HOME/.local/bin/idle_inhibit.sh --toggle >/dev/null 2>&1",
                    "update-command": "$HOME/.local/bin/idle_inhibit.sh --check >/dev/null 2>&1 && echo true || echo false"
                },
                {
                    "label": "󰝚",
                    "type": "toggle",
                    "active": true,
                    "command": "$HOME/.local/bin/cava_manager.sh >/dev/null 2>&1",
                    "update-command": "cat /tmp/cava-layer.pid && echo true || echo false"
                },
                {
                    "label": " ",
                    "type": "toggle",
                    "active": true,
                    "command": "$HOME/.local/bin/random_wallpaper.sh >/dev/null 2>&1",
                    "update-command": "cat /tmp/random_wallpaper_status | grep -q '1' && echo true || echo false"
                },
                {
                    "label": "󱂩",
                    "type": "toggle",
                    "active": true,
                    "command": "$HOME/.local/bin/dockbar_manager.sh --toggle >/dev/null 2>&1",
                    "update-command": "cat $HOME/.local/state/haku_theme/dockbar_manual_state | grep -q '1' && echo true || echo false"
                }
            ]
        },
        "menubar": {
            "menu#power-buttons": {
                "label": "󰤆",
                "position": "left",
                "actions": [
                    {
                        "label": "󰑓   Reboot",
                        "command": "systemctl reboot"
                    },
                    {
                        "label": "   Lock",
                        "command": "$HOME/.local/bin/lock.sh"
                    },
                    {
                        "label": "   Exit",
                        "command": "$HOME/.local/bin/exit.sh"
                    },
                    {
                        "label": "󰤆   Shut down",
                        "command": "systemctl poweroff"
                    }
                ]
            },
            "menu#powermode-buttons": {
                "label": "󱓞",
                "position": "left",
                "actions": [
                    {
                        "label": "Performance",
                        "command": "powerprofilesctl set performance"
                    },
                    {
                        "label": "Balanced",
                        "command": "powerprofilesctl set balanced"
                    },
                    {
                        "label": "Power-saver",
                        "command": "powerprofilesctl set power-saver"
                    }
                ]
            }
        }
    }
}