{
    "group/hworkspaces": {
        "orientation": "horizontal",
        "modules": [
            "ext/workspaces"
        ]
    },

    "group/vworkspaces": {
        "orientation": "vertical",
        "modules": [
            "ext/workspaces"
        ]
    },

    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "default": ""
        }
    },

    "hyprland/workspaces": {
        "all-outputs": true,
        "sort-by-number": true,
        "show-special": true,
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "default": ""
	    }
    },

    "mango/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "default": "",
            "urgent": "",
            "empty": ""
        },
        "on-click": "activate",
        "on-click-right": "toggle",
        "overview-label": "    ",
        "hide-empty": true
    },


    "ext/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "active": "",
            "default": ""
        },
        "sort-by-direction": "true"
    }
}