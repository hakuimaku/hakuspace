{
    "name": "dockbar",
    "layer": "top",
    "position": "bottom",
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 2,
    "tooltip": true,
    "reload_style_on_change": true,
    "exclusive": false,

    "modules-center": [
        "group/pin",
        "custom/separator",
        "wlr/taskbar"
    ],

    "custom/separator": {
        "format": " ",
        "tooltip": false
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "tooltip-format": "{title} {app_id}",
        "icon-size": 52,
        "on-click": "activate",
        "on-click-middle": "close",
        "on-click-right": "minimize",
        "all-outputs": true,
        "homogeneous": true,
        "justify": "center",
        "ignore-list": [
            "cavaunderbar",
            "seycava",
            "seylavat",
            "seyclock"
        ],
        "app_ids-mapping": {
            "seycmd": "kitty"
        }
    },

    "group/pin": {
        "orientation": "horizontal",
        "modules": [
            "image#menu",
            "image#kitty",
            "image#thunar"
        ]
    },

    "image#kitty": {
        "exec": "$HOME/.local/bin/dockbar_geticon.sh kitty",
        "size": 52,
        "interval": "once",
        "on-click": "kitty"
    },

    "image#thunar": {
        "exec": "$HOME/.local/bin/dockbar_geticon.sh thunar",
        "size": 52,
        "interval": "once",
        "on-click": "thunar"
    },

    "image#menu": {
        "exec": "$HOME/.local/bin/dockbar_geticon.sh menu",
        "size": 52,
        "interval": "once",
        "on-click": "$HOME/.local/bin/hakumenu.sh"
    }
}
