{
    "layer": "top",
    "position": "top",
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 0,
    "tooltip": true,
    "reload_style_on_change": true,

    "modules-center": [
        "clock",
        "custom/notification",
        "hyprland/workspaces",
        "niri/workspaces",
        "custom/recorder",
        "group/monitor",
        "group/bar"
    ],

    "clock": {
        "format": " {:%H:%M} ",
        "format-alt": " {:%A, %d %B %Y} ",
        "interval": 1,
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
                    "mode"          : "month",
                    "mode-mon-col"  : 3,
                    "weeks-pos"     : "right",
                    "on-scroll"     : 1,
                    "format": {
                              "months":     "<span color='#ffead3'><b>{}</b></span>",
                              "days":       "<span color='#ecc6d9'><b>{}</b></span>",
                              "weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
                              "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
                              "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
                              }
                    },
        "actions":  {
                    "on-click-right": "mode",
                    "on-scroll-up": "tz_up",
                    "on-scroll-down": "tz_down",
                    "on-scroll-up": "shift_up",
                    "on-scroll-down": "shift_down"
                    },
        "on-click-right": "~/.local/bin/hakumenu.sh"
    },

    "group/bar": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 1000,
            "transition-left-to-right": true,
            "click-to-reveal": true
        },
        "modules": [
            "custom/bar",
            "backlight",
            "backlight/slider",
            "pulseaudio",
            "pulseaudio/slider",
            "battery",
            "power-profiles-daemon",
            "tray"
        ]
    },

    "group/monitor": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 1000,
            "transition-left-to-right": true,
            "click-to-reveal": true
        },
        "modules": [
            "custom/monitor",
            "cpu",
            "memory",
            "temperature"
        ]
    },
    
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "on-scroll-up": "brightnessctl set 1%+",
        "on-scroll-down": "brightnessctl set 1%-",
        "on-click": "hyprsunset --temperature 3500",
        "on-click-right": "pkill hyprsunset",
        "tooltip-format": "Brightness: {percent}%"
    },

    "backlight/slider": {
        "min": 10,
        "max": 100,
        "orientation": "horizontal"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-icons": {
            "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
        },
        "tooltip-format": "Battery: {capacity}%\nPower: {power}W\n{timeTo}",
        "tooltip": true
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 ",
        "format-icons": {
            "headphone": "󰋋",
            "default": ["", "", ""]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "tooltip-format": "Volume: {volume}%"
    },

    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10,
        "show-passive-items": true
    },

    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "default": ""
        }
    },

    "hyprland/workspaces": {
        "all-outputs": true,
        "sort-by-number": true,
        "show-special": true,
        "format": "{icon}",
        "format-icons": {
            "magic": "",
            "active": "",
            "default": ""
	    }
    },

    "custom/recorder": {
        "exec": "if [ -f /tmp/recording_time ]; then cat /tmp/recording_time; fi",
        "interval": 1,
        "format": "󰑋",
        "tooltip": false,
        "return-type": "plain",
        "if-file-exists": "/tmp/recording_pid"
    },

    "custom/notification": {
        "tooltip": true,
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂚<span foreground='red'><sup></sup></span>",
            "none": "󰂚",
            "dnd-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-none": "",
            "inhibited-notification": "󰂚<span foreground='red'><sup></sup></span>",
            "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󰂛<span foreground='red'><sup></sup></span>",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "custom/bar": {
        "format": "󰣇 ",
        "tooltip-format": "Have a nice day!",
        "tooltip": true
    },

    "custom/monitor": {
        "format": " ",
        "tooltip-format": "Click to show monitor",
        "tooltip": true
    },

    "cpu": {
        "interval": 2,
        "format": "{usage}% "
    },

    "memory": {
        "interval": 2,
        "format": "{}% "
    },

     "temperature": {
        "interval": 2,
        "format": "{temperatureC}°C "
    }
}
