{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/hakufetch.txt",
        "type": "auto",
        "position": "top",
        "padding": { "top": 2, "left": 2 },
        "color": { "1": "blue" }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "blue", "output": "blue", "title": "blue" },
        "constants": ["\u001b[34m", "\u001b[34m"]
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "key": "  ╭─HakuSpace──╮"
        },
        {
            "type": "command",
            "key": "  │ {$2}{$1}  user    │",
            "text": "echo $USER"
        },
        {
            "type": "kernel",
            "key": "  │ {$2}󰌽{$1}  kernel  │"
        },
        {
            "type": "os",
            "key": "  │ {$2}{$1}  os      │"
        },
        {
            "type": "wm",
            "key": "  │ {$2}{$1}  wm      │"
        },
        {
            "type": "disk",
            "key": "  │ {$2}{$1}  disk    │",
            "folder": "/",
            "format": "{<12}{$1}"
        },
        {
            "type": "packages",
            "key": "  │   pkgs    │"
        },
        {
            "type": "custom",
            "key": "  ╰────────────╯"
        },
        {
            "type": "colors",
            "key": "  ",
            "symbol": "circle"
        }
    ]
}